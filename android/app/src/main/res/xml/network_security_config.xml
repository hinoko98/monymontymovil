<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite tráfico HTTP (sin TLS) solo hacia la API en desarrollo local.
  La API en producción se sirve por HTTPS, así que esto no debilita la
  seguridad de builds de release apuntando al backend real.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
